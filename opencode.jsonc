{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
    },
    "angular-cli": {
      "type": "local",
      "command": ["vpx", "-y", "@angular/cli", "mcp"],
      "enabled": true,
    },
  },
}
