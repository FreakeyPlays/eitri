{
  "name": "@eitri/client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve desktop",
    "build": "ng build desktop",
    "typecheck": "tsc -p projects/desktop/tsconfig.app.json --noEmit && tsc -p projects/desktop/tsconfig.spec.json --noEmit && tsc -p scripts/tsconfig.json",
    "watch": "ng build desktop --watch --configuration development",
    "test": "vp test run --project unit",
    "test:visual": "vp test --project storybook",
    "test:visual:update": "vp test -u --project storybook",
    "tauri": "tauri",
    "tauri:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "tauri:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "storybook": "ng run desktop:storybook",
    "build-storybook": "ng run desktop:build-storybook"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@eitri/contracts": "workspace:*",
    "@eitri/shared": "workspace:*",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "1.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "catalog:effect",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.1",
    "@angular-devkit/architect": "~0.2202.3",
    "@angular-devkit/core": "^22.2.3",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@spartan-ng/cli": "^1.7.0",
    "@storybook/addon-a11y": "11.0.0-alpha.6",
    "@storybook/addon-docs": "11.0.0-alpha.6",
    "@storybook/addon-vitest": "11.0.0-alpha.6",
    "@storybook/angular-vite": "11.0.0-alpha.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "happy-dom": "^21.0.3",
    "playwright": "1.64.1",
    "postcss": "^8.5.30",
    "storybook": "11.0.0-alpha.6",
    "storybook-addon-vis": "^4.3.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
