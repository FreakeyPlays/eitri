{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Eitri",
  "version": "../../../package.json",
  "identifier": "dev.chrismerck.eitri",
  "build": {
    "frontendDist": "../dist/desktop/browser",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vp run --parallel --filter @eitri/client --filter @eitri/server dev",
    "beforeBuildCommand": "vp run @eitri/client#sidecar && vp run @eitri/client#build"
  },
  "app": {
    "windows": [
      {
        "title": "Eitri",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 26 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["sidecar/eitri-server"]
  }
}
