--- /dev/null
+++ b/dist/src/bun-stack-trace.js
@@ -0,0 +1,8 @@
+// Bun only: once anything sets Error.prepareStackTrace (Babel, in Stryker's instrumenter, does),
+// Bun formats every captured stack through it, and its native fallback throws for the non-Error
+// objects Vite's bundled follow-redirects passes while this plugin loads. A plain V8-style
+// formatter accepts them.
+if (process.versions.bun) {
+    const errorToString = Function.call.bind(Error.prototype.toString);
+    Error.prepareStackTrace = (error, trace) => [errorToString(error), ...trace.map((frame) => `    at ${frame}`)].join('\n');
+}
